{
  "name": "dsh-tavily-mcp",
  "version": "0.1.0",
  "description": "Connect Tavily's remote MCP server to DeepSeek Harness. Search, extract, crawl, map, and research the web; the API key stays in the TAVILY_API_KEY credential.",
  "license": "MIT",
  "author": "NingYuanLee <liyunningyuan@outlook.com>",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "README*.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/index.js && node --check src/endpoint.js",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "npm test && npm run check && npm run check:pack"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NingYuanLee/dsh-tavily-mcp.git"
  },
  "homepage": "https://github.com/NingYuanLee/dsh-tavily-mcp#readme",
  "bugs": {
    "url": "https://github.com/NingYuanLee/dsh-tavily-mcp/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "tavily",
    "mcp",
    "web-search"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "tag": "latest"
  },
  "icon": "./icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-credentials": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-0 <0.3.0",
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}
